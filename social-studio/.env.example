# Groq API key for AI content generation. Server-side only: do NOT prefix with VITE_.
# Get your key at: https://console.groq.com/keys
# On Vercel, set GROQ_API_KEY under Project Settings -> Environment Variables.
# Restart the Vite dev server after changing this file.
GROQ_API_KEY=

# Image generation: Cloudflare Workers AI (FLUX.1 Schnell). Server-side only: do NOT prefix with VITE_.
# Account ID: Cloudflare dashboard -> Workers & Pages (right sidebar) or the URL of any account page.
# API token: My Profile -> API Tokens -> Create Token -> "Workers AI" template (Workers AI: Read + Edit).
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Vercel Blob storage for generated images. Server-side only.
# Vercel -> Storage -> Create Blob store -> connect to this project (adds this variable automatically).
# For local dev: `vercel env pull` or copy the token from the store's settings.
BLOB_READ_WRITE_TOKEN=
